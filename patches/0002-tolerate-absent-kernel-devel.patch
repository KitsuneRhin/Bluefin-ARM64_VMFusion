+# Remove kernel-devel from rpmdb because all package files are removed from /usr/src.
+# kernel-devel is pulled in by 04-install-kernel-akmods.sh, which does not run on
+# arches without an akmods build (e.g. aarch64), so it may legitimately be absent.
+if rpm -q kernel-devel >/dev/null 2>&1; then
+    rpm --erase --nodeps kernel-devel
+fi
 
